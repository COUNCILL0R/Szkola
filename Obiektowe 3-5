namespace Zad5
{
    internal class Program
    {
        static void Obliczenie()
        {
            float M;
            float a;
            float b;

            Console.WriteLine("Podaj wartość liczb a i b : ");
            a = float.Parse(Console.ReadLine());
            b = float.Parse(Console.ReadLine());
            if (a == 0 || b == 0)
            {
                Console.WriteLine("Liczba a oraz liczba b nie mogą przyjąć wartośći 0");
            }
            else
            {
                M = (a + a) / b + ((a / b) * a) / b + 1 / a;
                float Wynik = M;
                Console.WriteLine($"Wynik obliczenia to ; {Wynik}");
            }
        }
        
        static void Main(string[] args)
        {
           Obliczenie();
        }
    }
}
