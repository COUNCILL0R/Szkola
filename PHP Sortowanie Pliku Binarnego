        $plik = fopen("dane_wej.txt","rb");
        $linia = 0;
        while(!feof($plik)){
            $linie[$linia]= bindec(fgets($plik));
            
            $linia++;
        }
        fclose($plik);
        
        $plik = fopen("dane_wyj.txt","wb+");
        if(isset($_POST['przycisk1'])){
            rsort($linie);
            for($i=0;$i<sizeof($linie);$i++){
                $bin[$i] = decbin($linie[$i]);
                fwrite($plik, "$bin[$i]\n");
            }
        }
        
        if(isset($_POST['przycisk2'])){
            sort($linie);
            for($i=0;$i<sizeof($linie);$i++){
